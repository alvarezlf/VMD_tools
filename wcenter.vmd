#!/usr/local/bin/vmd
# Written by L. Alvarez~

#### Display settings 
display projection Perspective
#display projection Orthographic
display rendermode GLSL
#color Display {Background} white
display backgroundgradient on
color Display {BackgroundTop} cyan2
color Display {BackgroundBot} blue2
display resize 1080 900
display height 6.0
display depthcue off
display shadows off
display ambientocclusion off
display dof off
axes location off
#color Display {FPS} white
color Name {C} gray
#color Name {H} tan
color Labels {Atoms} red2
label textsize 1
label textthickness 2

#### UPDATE BONDS
proc adj_bonds {args} {mol bondsrecalc [lindex $args 1]}
trace add variable ::vmd_frame write adj_bonds

#### Global variables
set sf []
set txt_params []
set traj_len 1

#### FUNCTIONS ####
#Load files
proc load_files {file_traj file_wcen} {
  mol delete all
  global sf
  global traj_len

  mol new $file_traj type xyz first 0 last -1 step 1 filebonds 1 autobonds 1 waitfor all
  mol delrep 0 top
  mol representation CPK 0.7 0.2 20.0 20.0
  mol color Name
  mol selection {all}
  mol material AOChalky
  mol addrep top
  mol rename top atoms

  mol new $file_wcen type xyz first 0 last -1 step 1 filebonds 1 autobonds 1 waitfor all
  mol delrep 0 top
  mol representation CPK 0.3 0.0 20.0 10.0
  mol color ColorID 4
  mol selection {all}
  mol material AOChalky
  mol addrep top
  mol rename top Wannier

  set sf [lindex [lindex [lindex [molinfo top get scale_matrix] 0] 0] 0]
  set traj_len [molinfo top get frame]
  animate goto 0 

  helpme

}

# get_display
proc get_display {} {
  global sf
  set rot_matrix [molinfo top get {rotate_matrix}]
  set r11 [lindex [lindex [lindex $rot_matrix 0] 0] 0]
  set r12 [lindex [lindex [lindex $rot_matrix 0] 0] 1]
  set r13 [lindex [lindex [lindex $rot_matrix 0] 0] 2]
  set r21 [lindex [lindex [lindex $rot_matrix 0] 1] 0]
  set r22 [lindex [lindex [lindex $rot_matrix 0] 1] 1]
  set r23 [lindex [lindex [lindex $rot_matrix 0] 1] 2]
  set r31 [lindex [lindex [lindex $rot_matrix 0] 2] 0]
  set r32 [lindex [lindex [lindex $rot_matrix 0] 2] 1]
  set r33 [lindex [lindex [lindex $rot_matrix 0] 2] 2]

  set sy [expr {sqrt($r11*$r11 + $r21*$r21)}]
  set singular [expr {$sy < 1e-6}]
  if {$singular} {
      set x [expr {atan2(-$r23, $r22)}]  ;
      set y [expr {atan2(-$r31, $sy)}]   ;
      set z 0                            ;
  } else {
      set x [expr {atan2($r32, $r33)}]   ;
      set y [expr {atan2(-$r31, $sy)}]   ;
      set z [expr {atan2($r21, $r11)}]   ;
  }
  set rx [expr {$x*180/3.14159265}]
  set ry [expr {$y*180/3.14159265}]
  set rz [expr {$z*180/3.14159265}]
  set tx [lindex [lindex [lindex [molinfo top get global_matrix] 0] 0] 3]
  set ty [lindex [lindex [lindex [molinfo top get global_matrix] 0] 1] 3]
  set tz [lindex [lindex [lindex [molinfo top get global_matrix] 0] 2] 3]
  set d [display get distance]
  set s [expr [lindex [lindex [lindex [molinfo top get scale_matrix] 0] 0] 0]/$sf]

  return "$rx $ry $rz $tx $ty $tz $d $s"
}

# gen_display
proc gen_display txt {
  global txt_params
  set txt_params [split $txt " "]
  display resetview
  rotate x by [lindex $txt_params 0]
  rotate y by [lindex $txt_params 1]
  rotate z by [lindex $txt_params 2]
  translate by [lindex $txt_params 3] [lindex $txt_params 4] [lindex $txt_params 5]
  display distance [lindex $txt_params 6]
  scale by [lindex $txt_params 7]
}

# Movie generator
proc gen_movie {} {
display rendermode GLSL
global traj_len
for {set i 0} {$i <= $traj_len} {incr i 1} {
animate goto $i
set 5di [format "%05d" $i]
set outname "frame_$5di.png"
render TachyonInternal -format PNG $outname
}
}

# Format labels

proc form_labels {} {
for {set l 0} {$l < [llength [label list Atoms]]} {incr l} {label textformat Atoms $l %a%1i}
}

proc add_label {id} {
set nr [molinfo top]
label add Atoms $nr/[expr $id-1]
form_labels
}

proc add_labels {list} {
foreach i $list {add_label $i}
}

proc helpme {} {
puts ""
puts "-----------------------------------------------------"
puts "VMD file with minimal working parameters"
puts ""
puts "Functions:"
puts "load path/to/xyz  --->  load .xyz file"
puts "add_labels {list of IDs} ---> label specified atoms"
puts "form_labels  --->  Format labels"
puts "helpme ---> prints this help message"
puts "-----------------------------------------------------"
puts ""
}
proc saluteme {} {
puts ""
puts "-----------------------------------------------------"
puts "Enjoy!"
puts "~ L. Alvarez ~"
puts "November 2025"
puts "-----------------------------------------------------"
puts ""
}

# Window
proc savePOV {POV_file} {
  set POV_value [open $POV_file "w"]
  puts $POV_value [get_display]
  close $POV_value
  puts "Point of view saved in $POV_file"
}
proc loadPOV {POV_file} {
  set POV_value [open $POV_file "r"]
  gen_display [gets $POV_value]
  close $POV_value
  puts "Point of view loaded from $POV_file"
}

set wwh 20

proc gen_dialog {} {
  global wwh
  global fileList
  toplevel .custom_dialog
  wm title .custom_dialog "Wannier centers"

  label .custom_dialog.traj_label -text "Trajectory File:"
  grid .custom_dialog.traj_label -row 0 -column 0 -sticky ew
  entry .custom_dialog.traj_entry -width $wwh -textvariable traj_file
  grid .custom_dialog.traj_entry -row 0 -column 1 -sticky ew

  label .custom_dialog.wcen_label -text "Wannier's File:"
  grid .custom_dialog.wcen_label -row 1 -column 0 -sticky ew
  entry .custom_dialog.wcen_entry -width $wwh -textvariable wcen_file
  grid .custom_dialog.wcen_entry -row 1 -column 1 -sticky ew

  button .custom_dialog.load_files -text "Load files" -command {
  load_files $traj_file $wcen_file
  }
  grid .custom_dialog.load_files -row 1 -column 2 -sticky ew

  label .custom_dialog.povs_label -text "Save POV File:"
  grid .custom_dialog.povs_label -row 3 -column 0 -sticky ew
  entry .custom_dialog.pov_save_name -width $wwh -textvariable pov_save_name
  grid .custom_dialog.pov_save_name -row 3 -column 1 -sticky ew
  button .custom_dialog.pov_save -text "Save" -command {
    savePOV $pov_save_name
  }
  grid .custom_dialog.pov_save -row 3 -column 2 -sticky ew

  label .custom_dialog.povl_label -text "Load POV File:"
  grid .custom_dialog.povl_label -row 4 -column 0 -sticky ew
  entry .custom_dialog.pov_load_name -width $wwh -textvariable pov_load_name
  grid .custom_dialog.pov_load_name -row 4 -column 1 -sticky ew
  button .custom_dialog.pov_load -text "Load" -command {
    loadPOV $pov_load_name
  }
  grid .custom_dialog.pov_load -row 4 -column 2 -sticky ew

  button .custom_dialog.flabels -text "Format labels" -command {
  form_label
  }
  grid .custom_dialog.flabels -row 5 -column 0 -columnspan 1 -sticky ew

  button .custom_dialog.gen_movie -text "Render!" -command {gen_movie}
  grid .custom_dialog.gen_movie -row 5 -column 1 -columnspan 2 -sticky ew
}

#set f_pattern "Cube files"

gen_dialog

saluteme
helpme
puts ""




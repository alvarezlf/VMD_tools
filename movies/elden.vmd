#!/usr/local/bin/vmd
# Written by L. Alvarez~

#### Display settings 
# color for positive and negative Isosurfaces
#set IS_p 0.20

#display projection Perspective
display projection Orthographic
display rendermode GLSL
color Display {Background} black
#display backgroundgradient on
#color Display {BackgroundTop} cyan2
#color Display {BackgroundBot} blue2
display resize 900 720
display height 6.0
display depthcue off
display shadows off
display ambientocclusion off
display dof off
axes location off
#color Display {FPS} white

color Element {Al} silver
color Element {Li} purple
color Element {O} red3
color Element {Ti} gray
color Element {P} ochre

material change opacity Transparent 0.8
#color change rgb 2 0.35 0.35 0.35

#### UPDATE BONDS
proc adj_bonds {args} {mol bondsrecalc [lindex $args 1]}
trace add variable ::vmd_frame write adj_bonds

#### Global variables
set fileList []
set sf []
set txt_params []
set traj_len 1

#### FUNCTIONS ####
#Load files
proc load_cubes file_pattern {
  mol delete all
  global fileList
  global sf
  global traj_len

  set rawList [glob -nocomplain -type f $file_pattern]
#  set fileList [lsort $rawList]
#################################3
  set fileList {}
  foreach file $rawList {
    # Extract the number between the dots (assuming format file.NUMBER.ext)
    if {[regexp {\.(\d+)\.} $file -> number]} {
      lappend fileList [list $file $number]
    }
  }
  # Sort by the numeric value
  set fileList [lsort -integer -index 1 $fileList]
  
  # Extract just the filenames in sorted order
  set sortedFiles {}
  foreach pair $fileList {
    lappend sortedFiles [lindex $pair 0]
  }
  set fileList $sortedFiles
  puts $fileList
################################
  mol new [lindex $fileList 0] type cube first 0 last -1 step 1 filebonds 1 autobonds 1 waitfor all
  set remainingFiles [lrange $fileList 1 end]
  foreach file $remainingFiles {mol addfile $file type cube first 0 last -1 step 1 filebonds 1 autobonds 1 waitfor all}

  mol delrep 0 top
  mol representation cpk 1.0 0.3 20. 20.
  mol color Element
  mol selection {all}
  mol material AOChalky
  mol addrep top

  set sf [lindex [lindex [lindex [molinfo top get scale_matrix] 0] 0] 0]
  set traj_len [molinfo top get frame]
  animate goto 0 
}

# get_display
proc get_display {} {
  global sf
  set rot_matrix [molinfo top get {rotate_matrix}]
  set r11 [lindex [lindex [lindex $rot_matrix 0] 0] 0]
  set r12 [lindex [lindex [lindex $rot_matrix 0] 0] 1]
  set r13 [lindex [lindex [lindex $rot_matrix 0] 0] 2]
  set r21 [lindex [lindex [lindex $rot_matrix 0] 1] 0]
  set r22 [lindex [lindex [lindex $rot_matrix 0] 1] 1]
  set r23 [lindex [lindex [lindex $rot_matrix 0] 1] 2]
  set r31 [lindex [lindex [lindex $rot_matrix 0] 2] 0]
  set r32 [lindex [lindex [lindex $rot_matrix 0] 2] 1]
  set r33 [lindex [lindex [lindex $rot_matrix 0] 2] 2]

  set sy [expr {sqrt($r11*$r11 + $r21*$r21)}]
  set singular [expr {$sy < 1e-6}]
  if {$singular} {
      set x [expr {atan2(-$r23, $r22)}]  ;
      set y [expr {atan2(-$r31, $sy)}]   ;
      set z 0                            ;
  } else {
      set x [expr {atan2($r32, $r33)}]   ;
      set y [expr {atan2(-$r31, $sy)}]   ;
      set z [expr {atan2($r21, $r11)}]   ;
  }
  set rx [expr {$x*180/3.14159265}]
  set ry [expr {$y*180/3.14159265}]
  set rz [expr {$z*180/3.14159265}]
  set tx [lindex [lindex [lindex [molinfo top get global_matrix] 0] 0] 3]
  set ty [lindex [lindex [lindex [molinfo top get global_matrix] 0] 1] 3]
  set tz [lindex [lindex [lindex [molinfo top get global_matrix] 0] 2] 3]
  set d [display get distance]
  set s [expr [lindex [lindex [lindex [molinfo top get scale_matrix] 0] 0] 0]/$sf]

  return "$rx $ry $rz $tx $ty $tz $d $s"
}

# gen_display
proc gen_display txt {
  global txt_params
  set txt_params [split $txt " "]
  display resetview
  rotate x by [lindex $txt_params 0]
  rotate y by [lindex $txt_params 1]
  rotate z by [lindex $txt_params 2]
  translate by [lindex $txt_params 3] [lindex $txt_params 4] [lindex $txt_params 5]
  display distance [lindex $txt_params 6]
  scale by [lindex $txt_params 7]
}

# gen_wf Frame 
proc gen_wf F {
#  global IS_p

  mol delrep 1 top
#  mol delrep 1 top

  animate goto $F

  mol representation Isosurface 0.2 $F 0 0 1 1
#  mol color ColorID $IS_p
  mol selection {all}
  mol material Transparent
  mol addrep top
}

# Movie generator
proc gen_movie {} {
global fileList
global traj_len
for {set i 0} {$i <= $traj_len} {incr i 1} {
gen_wf $i
set cube [lindex $fileList $i]
set 5di [format "%05d" $i]
set outname "frame_$5di.ppm"
#set outname [regsub {\.cube} $cube ".ppm"]
render TachyonInternal $outname
}
}

# Window
proc savePOV {POV_file} {
  set POV_value [open $POV_file "w"]
  puts $POV_value [get_display]
  close $POV_value
  puts "Point of view saved in $POV_file"
}
proc loadPOV {POV_file} {
  set POV_value [open $POV_file "r"]
  gen_display [gets $POV_value]
  close $POV_value
  puts "Point of view loaded from $POV_file"
}

set wwh 12

proc gen_dialog {} {
  global wwh
  global fileList
  toplevel .custom_dialog
  wm title .custom_dialog "Movie generator"

  label .custom_dialog.files_label -text "Cube files:"
  grid .custom_dialog.files_label -row 0 -column 0 -sticky ew
  entry .custom_dialog.files_entry -textvariable f_pattern
  grid .custom_dialog.files_entry -row 0 -column 1 -sticky ew
  button .custom_dialog.files_load -text "Load files" -command {load_cubes $f_pattern}
  grid .custom_dialog.files_load -row 0 -column 2 -sticky ew

  label .custom_dialog.frame_label -text "Frame:" 
  grid .custom_dialog.frame_label -row 1 -column 0 -sticky ew
  entry .custom_dialog.frame_entry -textvariable frame_to_render
  grid .custom_dialog.frame_entry -row 1 -column 1 -sticky ew
  button .custom_dialog.frame_spec -text "Generate ISO" -command {gen_wf $frame_to_render}
  grid .custom_dialog.frame_spec -row 1 -column 2 -sticky ew

  button .custom_dialog.frame_curr -text "Generate current ISO" -command {
    set current_frame [molinfo top get frame]
    gen_wf $current_frame
  }
  grid .custom_dialog.frame_curr -row 2 -column 2 -sticky ew

  label .custom_dialog.povs_label -text "POV File:"
  grid .custom_dialog.povs_label -row 3 -column 0 -sticky ew
  entry .custom_dialog.pov_save_name -textvariable pov_save_name
  grid .custom_dialog.pov_save_name -row 3 -column 1 -sticky ew
  button .custom_dialog.pov_save -text "Save POV" -command {savePOV $pov_save_name}
  grid .custom_dialog.pov_save -row 3 -column 2 -sticky ew

  label .custom_dialog.povl_label -text "POV File:"
  grid .custom_dialog.povl_label -row 4 -column 0 -sticky ew
  entry .custom_dialog.pov_load_name -textvariable pov_load_name
  grid .custom_dialog.pov_load_name -row 4 -column 1 -sticky ew
  button .custom_dialog.pov_load -text "Load POV" -command {loadPOV $pov_load_name}
  grid .custom_dialog.pov_load -row 4 -column 2 -sticky ew

  button .custom_dialog.clean_iso -width $wwh -text "Clear surfaces" -command {mol delrep 1 top; mol delrep 1 top}
  grid .custom_dialog.clean_iso -row 5 -column 0 -sticky ew
  button .custom_dialog.flabels -width $wwh -text "Format labels" -command {form_label}
  grid .custom_dialog.flabels -row 5 -column 1 -columnspan 1 -sticky ew
  button .custom_dialog.gen_movie -width $wwh -text "Render!" -command {gen_movie}
  grid .custom_dialog.gen_movie -row 5 -column 2 -sticky ew
}

#gen_dialog

# Main procedure to create the window
proc create_gui {} {
    # Create the main window
    toplevel .main
    wm title .main "Load Files"

    # Create a notebook widget, which allows for tabbed pages
    package require Tk
    package require Ttk
    ttk::notebook .main.nb
    pack .main.nb -fill both -expand 1

    # Create the "Load Cube" tab
    frame .main.nb.cube
    .main.nb add .main.nb.cube -text "Load Cube"

    # Add content to the "Load Cube" tab
    label .main.nb.cube.label -text "This is the Load Cube tab."
    pack .main.nb.cube.label -padx 10 -pady 10

    button .main.nb.cube.button -text "Load Cube File" -command {
        puts "Loading Cube file..."
        # Here, you can add a function to load a Cube file
    }
    pack .main.nb.cube.button -padx 10 -pady 10

    # Create the "Load XYZ" tab
    frame .main.nb.xyz
    .main.nb add .main.nb.xyz -text "Load XYZ"

    # Add content to the "Load XYZ" tab
    label .main.nb.xyz.label -text "This is the Load XYZ tab."
    pack .main.nb.xyz.label -padx 10 -pady 10

    button .main.nb.xyz.button -text "Load XYZ File" -command {
        puts "Loading XYZ file..."
        # Here, you can add a function to load an XYZ file
    }
    pack .main.nb.xyz.button -padx 10 -pady 10
}

# Start the GUI
create_gui

